{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "schemas/events/tissue.schema.json", "title": "Tecidos (L2)", "description": "Contratos L2→L3 (f5 §3.2; f1 §7; contratos_camadas §2): TissueEvent versionado com rastreio per-tecido (f5 P5) e TissueState (snapshot do estado do tecido — ownership L2). O discriminador message_kind seleciona o registro; campos do envelope comum entram como propriedades adicionais.", "type": "object", "oneOf": [{"$ref": "#/$defs/tissue_event"}, {"$ref": "#/$defs/tissue_state"}], "$defs": {"tissue_id": {"type": "string", "description": "Identificador do tecido."}, "tissue_event": {"type": "object", "description": "Evento versionado de tecido com validade temporal; o estado permanece no owner L2.", "required": ["message_kind", "tissue_id", "event_id", "state_hash", "valid_until"], "properties": {"message_kind": {"const": "tissue_event", "description": "Discriminador do contrato L2."}, "tissue_id": {"$ref": "#/$defs/tissue_id"}, "event_id": {"type": "string", "format": "uuid", "description": "Identificador único do evento."}, "state_hash": {"type": "string", "description": "Hash canônico do estado do tecido (ex.: SHA-256 em hex)."}, "valid_until": {"type": "string", "format": "date-time", "description": "Validade do evento; após este instante o consumidor trata como STALE."}, "parent_event_id": {"type": "string", "format": "uuid", "description": "Evento ancestral do tecido."}, "feedback_id": {"type": "string", "description": "Feedback recebido posteriormente (5º elemento da camada, f4 §1)."}}}, "tissue_state": {"type": "object", "description": "Snapshot do estado do tecido (id, specialization, members, energy, coherence, capacity, connections).", "required": ["message_kind", "tissue_id", "specialization", "members", "energy", "coherence", "capacity", "connections"], "properties": {"message_kind": {"const": "tissue_state", "description": "Discriminador do contrato L2."}, "tissue_id": {"$ref": "#/$defs/tissue_id"}, "specialization": {"type": "string", "description": "Especialização funcional do tecido."}, "members": {"type": "array", "items": {"type": "string"}, "description": "Membros (clusters) do tecido."}, "energy": {"type": "number", "minimum": 0, "maximum": 1, "description": "Energia do tecido em [0, 1]."}, "coherence": {"type": "number", "minimum": 0, "maximum": 1, "description": "Coerência interna do tecido em [0, 1]."}, "capacity": {"type": "number", "minimum": 0, "description": "Capacidade atual do tecido (volume/throughput)."}, "connections": {"type": "array", "description": "Conexões (topologia) entre membros do tecido.", "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string", "description": "Membro de origem."}, "to": {"type": "string", "description": "Membro de destino."}, "weight": {"type": "number", "description": "Peso/força da conexão."}}}}}}}}
